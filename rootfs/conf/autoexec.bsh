# Run by every login shell, after /conf/bshrc and ~/.bshrc.
# After a text login without the graphical login (graphical=no in /conf/login.conf),
# this starts BDeskUI where there is a graphics mode; logging out of it logs out here
# too. With the graphical login on, a text login means you picked TTY, so you stay.
bdeskui --autostart && logout
